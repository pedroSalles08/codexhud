<Window x:Class="CodexHud.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex HUD"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        MinWidth="340"
        MaxWidth="560"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="#F3F4F5">
    <Window.Resources>
        <SolidColorBrush x:Key="LabelBrush" Color="#8E939B" />
        <SolidColorBrush x:Key="ValueBrush" Color="#F3F4F5" />
        <SolidColorBrush x:Key="SecondaryValueBrush" Color="#C1C5CA" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ValueBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Typography.NumeralStyle" Value="Lining" />
        </Style>

        <Style x:Key="MetricHitAreaStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="-4,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#08FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExpandButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#09FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#0DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#11FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryValueBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#E9EAEC" />
            <Setter Property="Background" Value="#F21A1B1E" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Placement" Value="Bottom" />
            <Setter Property="VerticalOffset" Value="4" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#E9EAEC" />
            <Setter Property="Background" Value="#F21A1B1E" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootSurface"
            CornerRadius="11"
            BorderThickness="1"
            BorderBrush="#18FFFFFF"
            Background="#FC111214"
            ClipToBounds="True">
        <Border.ContextMenu>
            <ContextMenu Background="#F21A1B1E"
                         BorderBrush="#22FFFFFF"
                         BorderThickness="1"
                         Padding="2">
                <MenuItem Header="Quit Codex HUD" Click="OnQuitClick" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Border x:Name="InteractionHighlight"
                    CornerRadius="10"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="1"
                    Background="#04FFFFFF"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <StackPanel>
                <Grid x:Name="CompactRow"
                      Height="40"
                      MinWidth="338"
                      Background="Transparent"
                      Focusable="True"
                      Cursor="Arrow"
                      MouseEnter="OnSurfaceMouseEnter"
                      MouseLeave="OnSurfaceMouseLeave"
                      PreviewMouseLeftButtonDown="OnCompactMouseLeftButtonDown"
                      PreviewMouseMove="OnCompactMouseMove"
                      PreviewMouseLeftButtonUp="OnCompactMouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ContextMetric"
                            Grid.Column="0"
                            Style="{StaticResource MetricHitAreaStyle}"
                            Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Context" />
                            <TextBlock x:Name="ContextValueText"
                                       Style="{StaticResource MetricValueStyle}"
                                       Margin="5,0,0,0"
                                       Text="—" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Margin="11,0"
                               Foreground="{StaticResource SeparatorBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Text="·" />

                    <Border x:Name="PrimaryMetric"
                            Grid.Column="2"
                            Style="{StaticResource MetricHitAreaStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PrimaryLabelText"
                                       Style="{StaticResource MetricLabelStyle}"
                                       Text="Usage" />
                            <TextBlock x:Name="PrimaryValueText"
                                       Style="{StaticResource MetricValueStyle}"
                                       Margin="5,0,0,0"
                                       Text="—" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="3"
                               Margin="11,0"
                               Foreground="{StaticResource SeparatorBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Text="·" />

                    <Border x:Name="SecondaryMetric"
                            Grid.Column="4"
                            Style="{StaticResource MetricHitAreaStyle}"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SecondaryLabelText"
                                       Style="{StaticResource MetricLabelStyle}"
                                       Text="Limit" />
                            <TextBlock x:Name="SecondaryValueText"
                                       Style="{StaticResource MetricValueStyle}"
                                       Margin="5,0,0,0"
                                       Text="—" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="ExpandButton"
                            Grid.Column="6"
                            Margin="0,0,6,0"
                            Style="{StaticResource ExpandButtonStyle}"
                            ToolTip="Show details"
                            AutomationProperties.Name="Show details"
                            Click="OnExpandButtonClick">
                        <Path Width="10"
                              Height="6"
                              Data="M 1,1 L 5,5 L 9,1"
                              Stroke="#7FFFFFFF"
                              StrokeThickness="1.25"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="None"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="ChevronRotation" Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                </Grid>

                <Border x:Name="ExpandedRegion"
                        Height="0"
                        Opacity="0"
                        ClipToBounds="True"
                        Visibility="Collapsed">
                    <StackPanel Margin="16,0,16,14">
                        <Border Height="1"
                                Margin="0,0,0,10"
                                Background="{StaticResource HairlineBrush}" />

                        <Grid x:Name="ContextDetailRow" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Context used" />
                            <TextBlock x:Name="ContextTokensText"
                                       Grid.Column="1"
                                       Margin="16,0,0,0"
                                       Style="{StaticResource DetailValueStyle}"
                                       Text="—" />
                        </Grid>

                        <Grid x:Name="PrimaryDetailRow" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PrimaryResetLabelText"
                                       Style="{StaticResource DetailLabelStyle}"
                                       Text="Usage resets" />
                            <TextBlock x:Name="PrimaryResetText"
                                       Grid.Column="1"
                                       Margin="16,0,0,0"
                                       Style="{StaticResource DetailValueStyle}"
                                       Text="—" />
                        </Grid>

                        <Grid x:Name="SecondaryDetailRow" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SecondaryResetLabelText"
                                       Style="{StaticResource DetailLabelStyle}"
                                       Text="Limit resets" />
                            <TextBlock x:Name="SecondaryResetText"
                                       Grid.Column="1"
                                       Margin="16,0,0,0"
                                       Style="{StaticResource DetailValueStyle}"
                                       Text="—" />
                        </Grid>

                        <Grid x:Name="FreshnessDetailRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Updated" />
                            <TextBlock x:Name="FreshnessText"
                                       Grid.Column="1"
                                       Margin="16,0,0,0"
                                       Style="{StaticResource DetailValueStyle}"
                                       Text="—" />
                        </Grid>

                        <TextBlock x:Name="EstimateExplanationText"
                                   Margin="0,10,0,0"
                                   Foreground="#AEB2B8"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Text="~100% is an estimate after reset; waiting for a fresh Codex reading." />

                        <TextBlock x:Name="StatusText"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource LabelBrush}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <StackPanel x:Name="AdditionalBucketsSection" Visibility="Collapsed">
                            <Border Height="1"
                                    Margin="0,11,0,9"
                                    Background="{StaticResource HairlineBrush}" />
                            <TextBlock Margin="0,0,0,7"
                                       Foreground="{StaticResource LabelBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="OTHER LIMITS" />
                            <ItemsControl x:Name="AdditionalBucketsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource DetailLabelStyle}"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="16,0,0,0"
                                                       Style="{StaticResource DetailValueStyle}"
                                                       Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
